{
  "name": "gemini-enterprise-admin-migration-tool",
  "version": "1.5.3",
  "description": "Enterprise admin-driven headless application for migrating Gemini Enterprise notebooks, custom agents, and datastores across GCP environments on behalf of users.",
  "main": "dist/index.js",
  "bin": {
    "gemini-migrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "ui": "tsx src/server.ts",
    "migrate": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:matrix": "tsx scripts/run-e2e-matrix.ts",
    "test:e2e-matrix": "tsx scripts/run-e2e-matrix.ts",
    "env:spinup": "bash scripts/spin-up-test-env.sh",
    "env:teardown": "bash scripts/teardown-test-env.sh",
    "docs:build": "tsx scripts/generate-guides-docx.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gemini-enterprise",
    "discovery-engine",
    "migration",
    "agents",
    "notebooks",
    "admin-tool",
    "headless"
  ],
  "author": "Google Cloud",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.5",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
